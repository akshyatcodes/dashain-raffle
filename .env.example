# Copy to .env and fill in. Keep .env out of git and readable only by the service owner (chmod 600).
# Generate values with:  openssl rand -base64 18   (passwords)   /   openssl rand -hex 32   (session secret)

# Organisers: sell tickets, paper books, prizes, settings, run the draw. At least 12 characters.
RAFFLE_ADMIN_PASSWORD=
# Finance: everything organisers can do, plus confirming payments, prices, collectors, money totals and the CSV export.
# At least 12 characters, and different from the organiser password.
RAFFLE_FINANCE_PASSWORD=
# Signs the login cookies. At least 32 characters. Changing it signs everyone out.
RAFFLE_SESSION_SECRET=

# Optional
# PORT=8080
# RAFFLE_ROLL_MS=4000      # how long the random-draw reel spins before landing, in milliseconds
